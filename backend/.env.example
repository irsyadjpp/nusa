APP_ENV=development
SERVER_PORT=:8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# PostgreSQL 18+ Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=nusa_user
DB_PASSWORD=nusa_password
DB_NAME=nusa_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=200
DB_MAX_IDLE_CONNS=50
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=ai_generation

# MinIO AI Storage Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_BUCKET=nusa-documents
MINIO_REGION=us-east-1

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h

# AI Configuration
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
AI_OPENAI_KEY=your-ai-api-key
AI_GEMINI_KEY=your-gemini-api-key
AI_TIMEOUT=30s
AI_MAX_RETRIES=3
